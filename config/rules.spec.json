          "demand": 0
        },
        {
          "id": "fairtrade",
          "demand": 0
        }
      ]
    },
    {
      "key": "sugar",
      "options": [
        {
          "id": "market",
          "unitCost": 1000000,
          "demand": 0
        },
        {
          "id": "direct",
          "unitCost": 1200000,
          "demand": 0
        },
        {
          "id": "fairtrade",
          "unitCost": 1400000,
          "demand": 0
        }
      ]
    },
    {
      "key": "price",
      "options": [
        {
          "id": "low",
