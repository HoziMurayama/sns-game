        "effects": [
          {
            "type": "demand",
            "mul": 0.8,
            "when": {
              "priceIn": [
                "high"
              ]
            }
          }
        ]
      },
      {
        "id": "sns_buzz",
        "body": "広告費を100万円使った会社は、販売数が20%増えます。",
        "effects": [
          {
            "type": "demand",
            "mul": 1.2,
            "when": {
              "adIn": [
                "large"
              ]
            }
          }
        ]
