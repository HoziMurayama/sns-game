  "events": {
    "noRepeat": true,
    "list": [
      {
        "id": "cacao_shortage",
        "body": "一般市場のカカオが40%値上がりしました。",
        "effects": [
          {
            "type": "materialCost",
            "slot": "cacao",
            "tier": "market",
            "mul": 1.4
          }
        ]
      },
      {
        "id": "sugar_price_up",
        "body": "一般市場の砂糖が30%値上がりしました。",
        "effects": [
          {
            "type": "materialCost",
            "slot": "sugar",
            "tier": "market",
            "mul": 1.3
          }
        ]
      },
      {
        "id": "fairtrade_boom",
